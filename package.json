{
  "name": "vaultgentic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "release": "pnpm build && changeset publish",
    "release:dry-run": "pnpm build && pnpm publish -r --dry-run --no-git-checks",
    "test": "turbo test",
    "version-packages": "changeset version && pnpm format",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.0.0",
    "lefthook": "^1.10.10",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
